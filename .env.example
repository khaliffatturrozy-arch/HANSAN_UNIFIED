# Local development uses an embedded PostgreSQL engine (PGlite) with durable
# files in .data/pglite. No database server is required.
HANSAN_DB_DRIVER=pglite
HANSAN_PGLITE_DIR=.data/pglite

# Production / self-hosted: use a real PostgreSQL server.
# HANSAN_DB_DRIVER=postgres
# DATABASE_URL=postgresql://hansan:change-me@localhost:5432/hansan

# Automatic migrations are enabled outside production unless overridden.
# HANSAN_AUTO_MIGRATE=false

# Demo data is opt-in only and is always disabled in production.
# Set HANSAN_DEMO_MODE=true and a unique local-only HANSAN_DEMO_PASSWORD
# (12+ characters) to seed the demo tenant. Never use demo credentials outside
# isolated local or test environments.
HANSAN_DEMO_MODE=false
HANSAN_DEMO_PASSWORD=

# Docker Compose only. Set POSTGRES_PASSWORD to a long random value in .env.
# POSTGRES_PASSWORD=
# APP_PORT=3000

# Enable the service worker. Keep off in development to avoid stale chunks.
NEXT_PUBLIC_ENABLE_SW=false

# Base URL used for QR links (optional).
NEXT_PUBLIC_APP_URL=http://localhost:3000
